# Copy this file to .env.local and fill in the values from your Supabase project.
# Do not put real keys in this file. Do not commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser.
# Never put it in a NEXT_PUBLIC_ name, and never paste it into chat.
SUPABASE_SERVICE_ROLE_KEY=

# Google Photos and Google Drive. These are public browser values, not the Supabase service role.
# Photos uses the Client ID only. Drive also needs the project number.
# No extra key is required for Google Photos.
# Client ID and project number are required. The API key is optional. Leave it empty.
# A filled-in key that Google rejects makes the file window say the key is invalid.
# Do not put real values in this file. Do not commit .env.local.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Server only. Paste the key from the Twelve Labs dashboard (API Keys).
# No quotes. Never use a NEXT_PUBLIC_ name. Never commit the real key.
# If this line is empty, Create Video matches titles and the library says
# “AI search not connected yet”.
TWELVE_LABS_API_KEY=

# Largest file this app will upload, in megabytes. Default is 5000 (5 GB) when this line is missing.
# Do not set this higher than the Supabase project's global file size limit.
# That limit is in the Supabase dashboard: Storage, then Settings, Global file size limit.
# If an upload is rejected, raise that Supabase setting. The app does not raise it for you.
NEXT_PUBLIC_MAX_UPLOAD_MB=5000

# Optional. Leave empty unless pasted Drive links are refused.
# yes = ask Google for permission to read files you can open, not only files you pick.
# The sign-in screen will ask to see your Drive files. See docs/google-drive-setup.md.
NEXT_PUBLIC_GOOGLE_DRIVE_READONLY=
