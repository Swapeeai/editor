# Copy this file to .env.local and fill in the values from your Supabase project.
# Do not put real keys in this file. Do not commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser.
# Never put it in a NEXT_PUBLIC_ name, and never paste it into chat.
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive import. These are public browser values, not the Supabase service role.
# Client ID and project number are required. The API key is optional. Leave it empty.
# A filled-in key that Google rejects makes the file window say the key is invalid.
# Do not put real values in this file. Do not commit .env.local.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Optional. Leave empty unless pasted Drive links are refused.
# yes = ask Google for permission to read files you can open, not only files you pick.
# The sign-in screen will ask to see your Drive files. See docs/google-drive-setup.md.
NEXT_PUBLIC_GOOGLE_DRIVE_READONLY=
