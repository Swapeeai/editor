# Copy this file to .env.local and fill in the values from your Supabase project.
# Do not put real keys in this file. Do not commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser.
# Never put it in a NEXT_PUBLIC_ name, and never paste it into chat.
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive import. These three are public browser values, not the Supabase service role.
# Leave them empty until you finish docs/google-drive-setup.md.
# Do not put real values in this file. Do not commit .env.local.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
